{
  "mcpServers": {
{{- if .isPersonal }}
    "Context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "$env:CONTEXT7_API_KEY"
      },
      "directTools": true
    },
    "DeepWiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "directTools": true
    },
    "StackOverflow": {
      "url": "https://mcp.stackoverflow.com",
      "directTools": true
    },
    "Tidewave": {
      "url": "http://localhost:4000/tidewave/mcp",
      "directTools": true
    },
{{- end }}
    "ChromeDevTools": {
      "command": "npx",
      "args": [
        "caveman-shrink",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.1.1",
        "--no-usage-statistics",
        "--browser-url=http://127.0.0.1:9222",
        "--category-performance=false",
        "--category-extensions=false",
        "--experimental-page-id-routing"
      ]
    },
    "Context-Mode": {
      "command": "context-mode",
      "directTools": true
    },
    "Serena": {
      "command": "npx",
      "args": ["caveman-shrink", "serena", "start-mcp-server", "--context=ide"]
    }
  }
}
