{
  "mcpServers": {
{{- if .isPersonal }}
    "Context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "DeepWiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "StackOverflow": {
      "url": "https://mcp.stackoverflow.com"
    },
    "Tidewave": {
      "url": "http://localhost:4000/tidewave/mcp"
    },
{{- end }}
    "ChromeDevTools": {
      "command": "npx",
      "args": [
        "-y", "chrome-devtools-mcp@1.1.1",
        "--no-usage-statistics",
        "--browser-url=http://{{ .chromeDevToolHost }}:9222",
        "--category-performance=false",
        "--category-extensions=false",
        "--experimental-page-id-routing"
      ]
    },
    "context-mode": {
      "command": "context-mode"
    },
    "ServerMemory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.1.26"],
      "env": {
        "MEMORY_FILE_PATH": "{{ .chezmoi.homeDir }}/mcp-server-memory.jsonl"
      }
    }
  }
}
