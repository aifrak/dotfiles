{
  "mcpServers": {
{{- if .isPersonal }}
    "Context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "$env:CONTEXT7_API_KEY"
      },
      "directTools": true
    },
    "DeepWiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "directTools": true
    },
    "StackOverflow": {
      "url": "https://mcp.stackoverflow.com",
      "directTools": true
    },
    "Tidewave": {
      "url": "http://localhost:4000/tidewave/mcp",
      "directTools": true
    },
{{- end }}
    "Context-Mode": {
      "command": "context-mode",
      "directTools": true
    },
    "Serena": {
      "command": "npx",
      "args": ["caveman-shrink", "serena", "start-mcp-server", "--context=ide"]
    }
  }
}
