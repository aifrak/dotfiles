{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isWSL := contains "microsoft" (dig "kernel" "osrelease" "" .chezmoi) -}}
{{- $isMacOs := eq .chezmoi.os "darwin" -}}
{{- $isUbuntu := eq (dig "osRelease" "id" "" .chezmoi) "ubuntu" -}}

{{- $windowsHostUserDir := "" -}}
{{- $wslMemory := "" -}}
{{- $keepassDatabase := "" -}}

{{- $computerType := promptChoiceOnce . "computerType" "Computer type" (list "personal" "work") -}}
{{- $isPersonal := eq $computerType "personal" -}}
{{- $isWork := eq $computerType "work" -}}

{{- if $isWindows -}}
{{- $wslMemory = promptStringOnce . "wslMemory" "WSL memory limit (e.g. 8GB, leave empty for default)" -}}
{{- else if $isWSL -}}
{{- $windowsHostUserDir = promptStringOnce . "windowsHostUserDir" "Name of user directory on Windows host" -}}
{{- end -}}
{{- if $isPersonal -}}
{{- $keepassDatabase = promptStringOnce . "keepassDatabase" "KeePassXC database full path" -}}
{{- end -}}

[data]
  isWindows = {{ $isWindows }}
  isUnix = {{ or $isWSL $isUbuntu $isMacOs }}
  isWSL = {{ $isWSL }}
  isMacOs = {{ $isMacOs }}
  isUbuntu = {{ $isUbuntu }}
  isPersonal = {{ $isPersonal }}
  isWork = {{ $isWork }}
  computerType = {{ $computerType | quote }}
  windowsHostUserDir = {{ $windowsHostUserDir | quote }}
  wslMemory = {{ $wslMemory | quote }}
  chromeDevToolHost = {{- if $isWSL -}}
{{- output "sh" "-c" "ip route show default | awk '{print $3}'" | trim | quote -}}
{{- else -}}
"127.0.0.1"
{{- end }}

{{ if $isPersonal }}
[keepassxc]
  database = {{ $keepassDatabase | quote }}
  {{ if $isWSL }}
  command = "/mnt/c/Users/{{ $windowsHostUserDir }}/scoop/apps/keepassxc/current/keepassxc-cli.exe"
  {{ end }}
{{ end }}
