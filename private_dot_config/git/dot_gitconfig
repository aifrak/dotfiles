[fetch]
  prune = true
[diff]
  tool = nvimdiff
  colorMoved = default
[difftool]
  prompt = false
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[core]
  editor = nvim --wait
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection
  line-numbers = true
[merge]
  tool = ec
  conflictStyle = zdiff3
[mergetool]
  prompt = false
  keepBackup = false
[mergetool "ec"]
  cmd = "ec \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\""
[mergetool "nvimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED"
[color "status"]
  added = green bold
  changed = red bold
  untracked = cyan
  branch = yellow black bold
